# Cube.dev 环境变量
# 复制为 .env 后由 docker-compose 自动加载

# Cube API 鉴权密钥（PoC 用简单值，生产请用强随机串）
CUBEJS_API_SECRET=datafabric-poc-secret-2026

# 开发模式：开启 schema 热加载，跳过 Redis 依赖
CUBEJS_DEV_MODE=true

# 数据源：Trino
CUBEJS_DB_TYPE=trino
CUBEJS_DB_HOST=trino
CUBEJS_DB_PORT=8080
CUBEJS_DB_USER=default
# Trino 默认 catalog（任意一个已配置的都可，schema 用三段引用即可跨 catalog）
CUBEJS_DB_NAME=mysql
CUBEJS_DB_SCHEMA=customer_db

# Web 端口
CUBEJS_API_PORT=4000

# 日志
CUBEJS_LOG_LEVEL=info
